{
  "$defs": {
    "Break": {
      "additionalProperties": false,
      "properties": {
        "break": {
          "enum": [
            "coffee",
            "lunch"
          ],
          "title": "Break",
          "type": "string"
        },
        "duration": {
          "pattern": "^(?:[1-9][0-9]*m|[1-9][0-9]*h(?: [1-5]?[1-9]m| [1-5]0m)?)$",
          "title": "Duration",
          "type": "string"
        }
      },
      "required": [
        "break"
      ],
      "title": "Break",
      "type": "object"
    },
    "Course": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "end": {
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "End",
          "type": "string"
        },
        "project_id": {
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "start": {
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Start",
          "type": "string"
        },
        "title": {
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "start",
        "end"
      ],
      "title": "Course",
      "type": "object"
    },
    "Day": {
      "additionalProperties": false,
      "properties": {
        "break_mode": {
          "enum": [
            "manual",
            "automatic"
          ],
          "title": "Break Mode",
          "type": "string"
        },
        "date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Date",
          "type": "string"
        },
        "end": {
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "End",
          "type": "string"
        },
        "label": {
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "location": {
          "pattern": "\\S",
          "title": "Location",
          "type": "string"
        },
        "schedule": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Break"
              },
              {
                "$ref": "#/$defs/Presentation"
              },
              {
                "$ref": "#/$defs/Exercise"
              },
              {
                "$ref": "#/$defs/Excursion"
              },
              {
                "$ref": "#/$defs/Interactive"
              }
            ]
          },
          "minItems": 1,
          "title": "Schedule",
          "type": "array"
        },
        "start": {
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "label",
        "schedule"
      ],
      "title": "Day",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "properties": {
        "break_mode": {
          "default": "manual",
          "enum": [
            "manual",
            "automatic"
          ],
          "title": "Break Mode",
          "type": "string"
        },
        "coffee_break": {
          "default": "15m",
          "pattern": "^(?:[1-9][0-9]*m|[1-9][0-9]*h(?: [1-5]?[1-9]m| [1-5]0m)?)$",
          "title": "Coffee Break",
          "type": "string"
        },
        "lunch": {
          "default": "45m",
          "pattern": "^(?:[1-9][0-9]*m|[1-9][0-9]*h(?: [1-5]?[1-9]m| [1-5]0m)?)$",
          "title": "Lunch",
          "type": "string"
        }
      },
      "title": "Defaults",
      "type": "object"
    },
    "Excursion": {
      "additionalProperties": false,
      "properties": {
        "duration": {
          "pattern": "^(?:[1-9][0-9]*m|[1-9][0-9]*h(?: [1-5]?[1-9]m| [1-5]0m)?)$",
          "title": "Duration",
          "type": "string"
        },
        "title": {
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "trainers": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Trainers",
          "type": "array"
        },
        "type": {
          "const": "Excursion",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "title",
        "trainers",
        "type",
        "duration"
      ],
      "title": "Excursion",
      "type": "object"
    },
    "Exercise": {
      "additionalProperties": false,
      "properties": {
        "duration": {
          "pattern": "^(?:[1-9][0-9]*m|[1-9][0-9]*h(?: [1-5]?[1-9]m| [1-5]0m)?)$",
          "title": "Duration",
          "type": "string"
        },
        "title": {
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "trainers": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Trainers",
          "type": "array"
        },
        "type": {
          "const": "Exercise",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "title",
        "trainers",
        "type",
        "duration"
      ],
      "title": "Exercise",
      "type": "object"
    },
    "Interactive": {
      "additionalProperties": false,
      "properties": {
        "duration": {
          "const": "remaining",
          "title": "Duration",
          "type": "string"
        },
        "title": {
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "trainers": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Trainers",
          "type": "array"
        },
        "type": {
          "const": "Interactive",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "title",
        "trainers",
        "type",
        "duration"
      ],
      "title": "Interactive",
      "type": "object"
    },
    "Presentation": {
      "additionalProperties": false,
      "properties": {
        "duration": {
          "pattern": "^(?:[1-9][0-9]*m|[1-9][0-9]*h(?: [1-5]?[1-9]m| [1-5]0m)?)$",
          "title": "Duration",
          "type": "string"
        },
        "title": {
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "trainers": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Trainers",
          "type": "array"
        },
        "type": {
          "const": "Presentation",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "title",
        "trainers",
        "type",
        "duration"
      ],
      "title": "Presentation",
      "type": "object"
    },
    "Trainer": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "email": {
          "format": "email",
          "title": "Email",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "email"
      ],
      "title": "Trainer",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "course": {
      "$ref": "#/$defs/Course"
    },
    "days": {
      "items": {
        "$ref": "#/$defs/Day"
      },
      "minItems": 1,
      "title": "Days",
      "type": "array"
    },
    "defaults": {
      "$ref": "#/$defs/Defaults"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "trainers": {
      "items": {
        "$ref": "#/$defs/Trainer"
      },
      "minItems": 1,
      "title": "Trainers",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "course",
    "trainers",
    "days"
  ],
  "title": "Course definition",
  "type": "object"
}
